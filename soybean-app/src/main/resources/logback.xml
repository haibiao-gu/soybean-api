<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">

    <!-- 使用环境变量配置 -->
    <property name="log.level" value="${LOG_LEVEL}"/>
    <property name="log.name" value="${APP_NAME}"/>
    <property name="log.path" value="${LOG_PATH}"/>
    <property name="log.charset" value="UTF-8"/>
    <property name="log.timeFormat" value="yyyy-MM-dd"/>
    <property name="log.maxHistory" value="${LOG_HISTORY}"/>
    <property name="log.maxFileSize" value="${LOG_SIZE}"/>

    <!-- 日志格式 -->
    <property name="log.pattern.prod"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level ${PID} -- [%25.25thread{24}] [%40.40logger{39}] [%X{requestId}] : %msg%n"/>
    <property name="log.pattern.dev"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) %cyan(%40.40logger{39}) - %green(%-4line) [%X{requestId}] : %msg%n"/>

    <!-- 控制台输出 -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${log.pattern.${PROFILES_ACTIVE}}</pattern>
            <charset>${log.charset}</charset>
        </encoder>
    </appender>

    <!-- 异步控制台输出 -->
    <appender name="ASYNC_STDOUT" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="STDOUT"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>true</includeCallerData>
    </appender>

    <!-- 普通日志文件输出 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/${log.name}-info.log</file>
        <encoder>
            <pattern>${log.pattern.prod}</pattern>
            <charset>${log.charset}</charset>
        </encoder>
        <!-- 日志级别过滤器 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${log.level}</level>
        </filter>
        <!-- 滚动策略：按时间 + 大小滚动 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/info/${log.name}-info.%d{${log.timeFormat}}-%i.log.gz</fileNamePattern>
            <maxFileSize>${log.maxFileSize}</maxFileSize>
            <maxHistory>${log.maxHistory}</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 异步普通日志输出 -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>true</includeCallerData>
    </appender>

    <!-- 错误日志文件输出 -->
    <appender name="FILE-ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/${log.name}-error.log</file>
        <encoder>
            <pattern>${log.pattern.prod}</pattern>
            <charset>${log.charset}</charset>
        </encoder>
        <!-- 错误日志级别过滤器 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <!-- 错误日志滚动策略 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/error/${log.name}-error.%d{${log.timeFormat}}-%i.log.gz</fileNamePattern>
            <maxFileSize>${log.maxFileSize}</maxFileSize>
            <maxHistory>${log.maxHistory}</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 异步错误日志输出 -->
    <appender name="ASYNC_FILE_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE-ERROR"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>true</includeCallerData>
    </appender>

    <!-- 根日志器配置 -->
    <root level="${log.level}">
        <appender-ref ref="ASYNC_STDOUT"/>
        <appender-ref ref="ASYNC_FILE"/>
        <appender-ref ref="ASYNC_FILE_ERROR"/>
    </root>

</configuration>
