# 运行环境*
APP_NAME=Soybean-API
PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Flyway配置*
FLYWAY_ENABLED=true
FLYWAY_CLEAN_DISABLED=false
# Redis连接
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
# Postgresql连接
DATASOURCE_URL=127.0.0.1:5432/soybean
DATASOURCE_USERNAME=soybean
DATASOURCE_PASSWORD=
# Token配置
TOKEN_TIMEOUT=36000
TOKEN_ACTIVE_TIMEOUT=3600
# 日志配置
LOG_LEVEL=INFO
LOG_PATH=./logs/
LOG_HISTORY=1
LOG_SIZE=100MB
TOKEN_LOG=true
